+@file:Suppress("INVISIBLE_MEMBER", "INVISIBLE_REFERENCE", "RestrictedApiAndroidX")
+
+package expo.modules.widgets
+
+import android.content.Context
+import android.os.Build
+import android.os.SystemClock
+import android.util.TypedValue
+import android.view.Gravity
+import android.widget.RemoteViews
+import androidx.glance.Emittable
+import androidx.glance.GlanceModifier
+import androidx.glance.appwidget.EmittableAndroidRemoteViews
+
+/** Text'in textAlign'ından yazının kap içindeki hizası */
+internal fun countdownGravity(align: String?): Int = when (align) {
+  "center" -> Gravity.CENTER
+  "right", "end" -> Gravity.END or Gravity.CENTER_VERTICAL
+  else -> Gravity.START or Gravity.CENTER_VERTICAL
+}
+
+// MATAF: canlı geri sayım. Text'e countdownTo (hedef an, ms) verilirse Android Chronometer çizilir; başlatıcı onu
+// saniye saniye kendisi işletir, uygulamanın ya da küçük uygulamanın yenilenmesi gerekmez. Vakit girince
+// (WidgetTicks alarmı) küçük uygulama yeniden çizilir ve sayaç sıradaki vakte kurulur. EmittableAndroidRemoteViews
+// Glance'te internal; peek-emittables da aynı yolla kullanıyor (EmittableTree doğrulayıcısı bu düğümü kabul ediyor).
+internal fun countdownEmittable(
+  context: Context,
+  targetMs: Long,
+  color: Int?,
+  fontSizeSp: Float?,
+  gravity: Int,
+  modifier: GlanceModifier
+): Emittable? {
+  if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return null
+  val views = RemoteViews(context.packageName, R.layout.expo_widgets_countdown)
+  val base = SystemClock.elapsedRealtime() + (targetMs - System.currentTimeMillis())
+  views.setChronometer(R.id.expo_widgets_countdown, base, null, true)
+  views.setChronometerCountDown(R.id.expo_widgets_countdown, true)
+  if (color != null) views.setTextColor(R.id.expo_widgets_countdown, color)
+  if (fontSizeSp != null) views.setTextViewTextSize(R.id.expo_widgets_countdown, TypedValue.COMPLEX_UNIT_SP, fontSizeSp)
+  // Sayaç kabını doldurur (Glance onu kabın kalan alanına yayar); yazı kabın içinde hizalanır
+  views.setInt(R.id.expo_widgets_countdown, "setGravity", gravity)
+  return EmittableAndroidRemoteViews().also {
+    it.remoteViews = views
+    it.modifier = modifier
+  }
+}
