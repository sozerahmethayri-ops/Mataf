{
  "expo": {
    "name": "MATAF",
    "slug": "mataf",
    "version": "0.12.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mataf",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.mataf.navigator",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MATAF, Mescid içinde ve çevresinde konumunuzu göstermek ve size yol tarif etmek için konumunuzu kullanır.",
        "NSPhotoLibraryUsageDescription": "Kapı bildirimine fotoğraf eklemek için."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mataf.navigator",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 17
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MATAF, Mescid içinde ve çevresinde konumunuzu göstermek ve size yol tarif etmek için konumunuzu kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kapı bildirimine fotoğraf eklemek için."
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C2410C",
          "sounds": [
            "./assets/sounds/zil.wav",
            "./assets/sounds/can_sesi.wav",
            "./assets/sounds/nagme.wav",
            "./assets/sounds/damla.wav"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "PrayerWidget",
              "displayName": "MATAF · Günün vakitleri",
              "description": "Sıradaki namaz ve altı vakit yan yana",
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/PrayerWidget.tsx"
              },
              "ios": null
            },
            {
              "name": "NextPrayerWidget",
              "displayName": "MATAF · Sıradaki vakit",
              "description": "Sıradaki namaz büyük yazıyla",
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/NextPrayerWidget.tsx"
              },
              "ios": null
            },
            {
              "name": "PrayerListWidget",
              "displayName": "MATAF · Vakit listesi",
              "description": "Altı vakit alt alta",
              "android": {
                "minWidth": 120,
                "minHeight": 180,
                "targetCellWidth": 2,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/PrayerListWidget.tsx"
              },
              "ios": null
            },
            {
              "name": "PrayerStripWidget",
              "displayName": "MATAF · İnce şerit",
              "description": "Sıradaki ve sonraki vakit tek satırda",
              "android": {
                "minWidth": 250,
                "minHeight": 40,
                "targetCellWidth": 4,
                "targetCellHeight": 1,
                "resizeMode": "horizontal",
                "initialLayout": "./src/widgets/PrayerStripWidget.tsx"
              },
              "ios": null
            }
          ]
        }
      ],
      "./plugins/withGradleMemory"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
