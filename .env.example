# Canlı bildirim sunucusu (isteğe bağlı). Boş bırakılırsa uygulama yerel demo modunda çalışır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Toplu taşıma tarifi (isteğe bağlı): Transitous (https://transitous.org) — yalnız açık kaynak ve ticari olmayan
# projeler için. Uygulamayı tanıtan User-Agent'ta kullanılacak iletişim adresi (e-posta ya da proje bağlantısı).
# Boş bırakılırsa metro/otobüs tarifi telefonun harita uygulamasında (Google/Apple) açılır.
EXPO_PUBLIC_TRANSITOUS_CONTACT=
